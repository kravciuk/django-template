DEBUG=True
SECRET_KEY=dev-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin
DB_NAME=geo_db
DB_USER=geo_user
DB_PASSWORD=dev_password
DB_HOST=pgbouncer
DB_PORT=6432
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=100
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_DEFAULT_QUEUE=low
CELERY_HIGH_QUEUE=high
# Prod worker processes for the Google Calendar sync queues (docker-compose.prod.yml).
# Keep every worker's concurrency together under PGBOUNCER_MAX_CLIENT_CONN.
CELERY_GOOGLE_CONCURRENCY=8
CELERY_GOOGLE_BULK_CONCURRENCY=16
GEOIP_PATH=/app/geoip/GeoLite2-City.mmdb
MAXMIND_LICENSE_KEY=your_key
JWT_SECRET_KEY=jwt-secret-key
JWT_EXPIRATION=3600

# --- Auth (django-allauth) ---
# Whether registration is open (ACCOUNT_ALLOW_SIGNUP) is a constance setting,
# not an env var - see core/settings/constance.py; toggle it at
# /admin/constance/config/.
MFA_TOTP_ISSUER=django-template
# Passkeys (WebAuthn) are always on as a login method - see
# core/settings/auth.py. This flag is only for testing over plain http from
# a non-localhost dev host (e.g. a LAN IP); leave unset/false everywhere
# else, and never set it in prod - WebAuthn requires a secure context
# (https or the literal host "localhost") by browser spec.
MFA_WEBAUTHN_ALLOW_INSECURE_ORIGIN=false
# Dev default is the console backend (prints mails to the django container's
# log instead of sending them) - set real SMTP values here for prod.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=webmaster@localhost
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_CONSOLE_COLOR=true
# Log every SQL query (django.db.backends); only honored together with LOG_LEVEL=DEBUG.
LOG_SQL=false
LOG_FILE_MAX_SIZE=20
LOG_FILE_BACKUP_COUNT=5
LOG_DIR=/logs
LOG_EXCLUDE_PATHS=/health/,/metrics/
CELERY_LOG_LEVEL=DEBUG
CELERY_LOG_FILE=/logs/celery/celery.log
CELERY_LOG_ERROR_FILE=/logs/celery/celery_error.log
CLOUDFLARE_HEADER_IP=HTTP_CF_CONNECTING_IP
CLOUDFLARE_HEADER_COUNTRY=HTTP_CF_IPCOUNTRY
CLOUDFLARE_HEADER_RAY=HTTP_CF_RAY
MASK_PATTERNS=password,token,refresh,access,api_key,secret,credit_card

POSTGRES_INITDB_ARGS=
STATIC_ROOT=/var/static
MEDIA_ROOT=/var/media
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
INTERNAL_IPS=127.0.0.1,localhost
ENABLE_DEBUG_TOOLBAR=true

# --- Personal content store (apps.common/comments/sharing/attachments/content) ---
ATTACHMENTS_MAX_UPLOAD_SIZE=26214400
# Comma-separated whitelist of allowed upload extensions; empty means no restriction.
ATTACHMENTS_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,txt,csv,rtf
ATTACHMENTS_MAX_FILES_PER_UPLOAD=10
TRASH_RETENTION_DAYS=30
DRAFT_RETENTION_DAYS=7
COMMENTS_MAX_DEPTH=5

# --- Notifications ---
NOTIFICATIONS_RETENTION_DAYS=90

# --- Google Calendar sync (apps.events.google) - see docs/operations/google-calendar.md ---
# Site-wide OAuth client - optional: users can enter their own on /events/google/ instead.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact callback URL registered in Google Cloud; required in prod (Django sees http behind the TLS proxy).
# Dev: http://localhost:81/oauth/google/callback/
GOOGLE_OAUTH_REDIRECT_URI=
# Comma-separated Fernet keys for stored tokens (first encrypts). Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Public base URL for links from Google events back to notes, e.g. https://example.com
SITE_URL=
# Dev defaults: run "Sync now" inline (no Celery worker), don't queue per-save pushes.
# GOOGLE_CALENDAR_SYNC_INLINE=1
# GOOGLE_CALENDAR_ENQUEUE_ON_SAVE=0
