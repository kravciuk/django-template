DEBUG=True
SECRET_KEY=dev-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=geo_db
DB_USER=geo_user
DB_PASSWORD=dev_password
DB_HOST=pgbouncer
DB_PORT=6432
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=100
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_DEFAULT_QUEUE=low
CELERY_HIGH_QUEUE=high
GEOIP_PATH=/app/geoip/GeoLite2-City.mmdb
MAXMIND_LICENSE_KEY=your_key
JWT_SECRET_KEY=jwt-secret-key
JWT_EXPIRATION=3600
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_CONSOLE_COLOR=true
LOG_FILE_MAX_SIZE=20
LOG_FILE_BACKUP_COUNT=5
LOG_DIR=/logs
LOG_EXCLUDE_PATHS=/health/,/metrics/
CELERY_LOG_LEVEL=DEBUG
CELERY_LOG_FILE=/logs/celery/celery.log
CELERY_LOG_ERROR_FILE=/logs/celery/celery_error.log
CLOUDFLARE_HEADER_IP=HTTP_CF_CONNECTING_IP
CLOUDFLARE_HEADER_COUNTRY=HTTP_CF_IPCOUNTRY
CLOUDFLARE_HEADER_RAY=HTTP_CF_RAY
MASK_PATTERNS=password,token,refresh,access,api_key,secret,credit_card

POSTGRES_INITDB_ARGS=
BACKUP_RETENTION_DAYS=7
STATIC_ROOT=/var/static
MEDIA_ROOT=/var/media
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
INTERNAL_IPS=127.0.0.1,localhost
ENABLE_DEBUG_TOOLBAR=true

# --- Personal content store (apps.common/comments/sharing/attachments/content) ---
ATTACHMENTS_MAX_UPLOAD_SIZE=26214400
ATTACHMENTS_ALLOWED_EXTENSIONS=
ATTACHMENTS_MAX_FILES_PER_UPLOAD=10
TRASH_RETENTION_DAYS=30
DRAFT_RETENTION_DAYS=7
COMMENTS_MAX_DEPTH=5
