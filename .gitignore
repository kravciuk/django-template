# Секреты — .env.dev/.env.prod содержат пароли/ключи, в реальном репозитории
# должны игнорироваться (в этой поставке оставлены как заполняемые шаблоны).
.env
.env.*
!.env.example
.llm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# docker-compose.yml mounts the root-level tests/ and pytest.ini into the
# django container under src/ so they're visible at /app - Docker creates
# matching empty placeholder entries here as the mount points.
/src/tests/
/src/pytest.ini

# Логи, медиа, статика, бэкапы — генерируются в рантайме
logs/*
!logs/**/.gitkeep
var/media/*
!var/media/.gitkeep
var/static/*
!var/static/.gitkeep
backups/*
!backups/.gitkeep

# GeoIP-база скачивается скриптом init_geoip.sh, в репозиторий не кладём
geoip/

# IDE
.idea/
.vscode/


