# syntax=docker/dockerfile:1
# Dockerfile.dev — образ Django для локальной разработки (DEV).
# Ожидаемый контекст сборки: корень проекта (см. docker-compose.yml).

FROM python:3.14-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Системные зависимости для GeoDjango (GDAL/PROJ), GeoIP и pg_dump/psql
# (последние нужны scripts/backup_db.sh и scripts/restore_db.sh)
RUN apt-get update && apt-get install -y --no-install-recommends \
        binutils \
        libproj-dev \
        gdal-bin \
        libgeoip-dev \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Устанавливаем зависимости отдельным слоем для кэширования
COPY src/requirements/ /app/requirements/
RUN pip install -r requirements/dev.txt

# Копируем исходный код (в DEV будет перекрыт volume-монтированием ./src:/app)
COPY src/ /app/

COPY docker/django/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# scripts/ используется Celery-задачами бэкапа/GeoIP (core/tasks.py) и Makefile
COPY scripts/ /scripts/
RUN chmod +x /scripts/*.sh

# Нужно, чтобы dev-образ можно было использовать как DJANGO_IMAGE при сборке
# docker/nginx/Dockerfile (multi-stage COPY --from забирает /app/static оттуда).
# В самом dev-контейнере ./src:/app перекрывает это volume-монтированием — на
# runserver и раздачу статики через Django (DEBUG=True) это не влияет.
RUN python manage.py collectstatic --noinput

ENTRYPOINT ["/entrypoint.sh"]
# uvicorn напрямую поверх core.asgi:application, а не manage.py runserver:
# у channels 4.x нет ASGI-варианта runserver (есть только runworker), поэтому
# WebSocket через runserver обслуживаться не может. --reload даёт то же
# автоперезагрузка при правке кода, что и runserver.
CMD ["uvicorn", "core.asgi:application", "--host", "0.0.0.0", "--port", "8000", "--reload"]
